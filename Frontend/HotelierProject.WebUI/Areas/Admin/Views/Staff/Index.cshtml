@model List<StaffViewModel>

@{
    ViewData["Title"] = "Personel Listesi";
}

<div class="row page-titles mx-0 mb-4">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4>Personel Yönetimi</h4>
            <p class="mb-0">Otel kadrosundaki tüm personellerin listesi ve yönetimi</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <a asp-area="Admin" asp-controller="Staff" asp-action="Create" class="btn btn-primary d-inline-flex align-items-center">
            Yeni Personel Ekle <span class="btn-icon-right"><i class="fa fa-user-plus"></i></span>
        </a>
    </div>
</div>

<div class="row">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <!-- Profil Başlığı & Nötr Avatar -->
                        <div class="media align-items-center mb-4">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img class="mr-3 rounded-circle shadow-sm border" 
                                     src="http://localhost:5241/@item.ImageUrl" 
                                     width="70" height="70" 
                                     style="object-fit: cover;" 
                                     alt="@item.Name" />
                            }
                            else
                            {
                                <div class="mr-3 rounded-circle bg-light d-flex align-items-center justify-content-center text-secondary border shadow-sm" 
                                     style="width: 70px; height: 70px; min-width: 70px;">
                                    <i class="fa fa-user fa-2x text-muted"></i>
                                </div>
                            }
                            <div class="media-body">
                                <h4 class="mb-1 text-dark font-weight-bold">@item.Name</h4>
                                <p class="text-muted mb-0 font-weight-medium">@item.Title</p>
                            </div>
                        </div>

                        <!-- 3'lü Sosyal Medya İstatistik Barı -->
                        <div class="row mb-4 text-center">
                            <div class="col-4 border-right px-1">
                                <div class="py-2">
                                    <i class="fa fa-instagram text-primary fa-lg mb-2"></i>
                                    <h6 class="mb-0 text-muted small font-weight-bold">Instagram</h6>
                                    <small class="text-muted text-truncate d-block" title="@item.SocialMedia1">
                                        @(string.IsNullOrWhiteSpace(item.SocialMedia1) ? "-" : item.SocialMedia1)
                                    </small>
                                </div>
                            </div>
                            <div class="col-4 border-right px-1">
                                <div class="py-2">
                                    <i class="fa fa-linkedin text-info fa-lg mb-2"></i>
                                    <h6 class="mb-0 text-muted small font-weight-bold">LinkedIn</h6>
                                    <small class="text-muted text-truncate d-block" title="@item.SocialMedia2">
                                        @(string.IsNullOrWhiteSpace(item.SocialMedia2) ? "-" : item.SocialMedia2)
                                    </small>
                                </div>
                            </div>
                            <div class="col-4 px-1">
                                <div class="py-2">
                                    <i class="fa fa-twitter text-primary fa-lg mb-2"></i>
                                    <h6 class="mb-0 text-muted small font-weight-bold">Twitter</h6>
                                    <small class="text-muted text-truncate d-block" title="@item.SocialMedia3">
                                        @(string.IsNullOrWhiteSpace(item.SocialMedia3) ? "-" : item.SocialMedia3)
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- Aksiyon Butonları -->
                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-area="Admin" asp-controller="Staff" asp-action="Edit" asp-route-id="@item.Id" 
                               class="btn btn-outline-info btn-sm px-3 d-inline-flex align-items-center">
                                <i class="fa fa-pencil mr-1"></i> Düzenle
                            </a>

                            <form asp-area="Admin" asp-controller="Staff" asp-action="Delete" asp-route-id="@item.Id" 
                                  method="post" onsubmit="return confirm('Bu personeli silmek istediğinize emin misiniz?');" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm px-3 d-inline-flex align-items-center">
                                    <i class="fa fa-trash mr-1"></i> Sil
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info text-center py-4">
                <i class="fa fa-info-circle fa-2x mb-2"></i>
                <h5>Kayıtlı personel bulunamadı.</h5>
                <p class="mb-0">Yeni personel eklemek için yukarıdaki butonu kullanabilirsiniz.</p>
            </div>
        </div>
    }
</div>